{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moesegfault-notifications-staging",
  "main": "./apps/notifications/src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "vars": { "ENVIRONMENT": "staging" },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "moesegfault-notifications-staging",
    "database_id": "",
    "migrations_dir": "./migrations/notifications"
  }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "env": {
    "production": {
      "name": "moesegfault-notifications",
      "vars": { "ENVIRONMENT": "production" },
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "moesegfault-notifications-production",
        "database_id": "",
        "migrations_dir": "./migrations/notifications"
      }],
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
