{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moesegfault-platform-journey-staging",
  "main": "./apps/platform-journey/src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "services": [
    {"binding": "NOTIFICATIONS", "service": "moesegfault-notifications-staging", "entrypoint": "NotificationsApi"},
    {"binding": "DECISIONS", "service": "moesegfault-decisions-staging", "entrypoint": "DecisionsApi"}
  ],
  "d1_databases": [{"binding": "DB", "database_name": "moesegfault-decisions-staging", "database_id": ""}],
  "observability": {"enabled": true, "logs": {"enabled": true, "invocation_logs": false, "head_sampling_rate": 1}}
}
