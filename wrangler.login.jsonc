{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moesegfault-login-staging",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/login/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "env": {
    "production": {
      "name": "moesegfault-login",
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
