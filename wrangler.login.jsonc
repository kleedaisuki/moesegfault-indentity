{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moesegfault-login-staging",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "login-staging.moesegfault.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./apps/login/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "production": {
      "name": "moesegfault-login",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "login.moesegfault.dev",
          "custom_domain": true
        }
      ]
    }
  }
}
