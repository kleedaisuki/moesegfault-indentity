/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://identity.moesegfault.dev https://identity-staging.moesegfault.dev; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Vite entry bundle filenames include content hashes; HTML and public icons must revalidate.
/assets/index-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/index-*.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
