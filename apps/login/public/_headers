/*
  Cache-Control: no-store, no-transform
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src https://identity.moesegfault.dev https://identity-staging.moesegfault.dev; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: publickey-credentials-get=(self), publickey-credentials-create=(self)

# Only Vite's content-hashed entry bundles are immutable. Public SVG names remain mutable.
# Matching rules append values, so detach the inherited no-store policy first.
/assets/index-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/index-*.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
