{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moesegfault-account-staging",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "account-staging.moesegfault.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./apps/account/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "env": {
    "production": {
      "name": "moesegfault-account",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "account.moesegfault.dev",
          "custom_domain": true
        }
      ]
    }
  }
}
