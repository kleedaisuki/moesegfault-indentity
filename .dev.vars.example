# Local-only Worker variables; copy to .dev.vars. / 仅限本地的 Worker 变量，请复制为 .dev.vars。
ENVIRONMENT=development
ISSUER=http://localhost:8787
LOGIN_ORIGIN=http://localhost:5173
ACCOUNT_ORIGIN=http://localhost:5174
# Production/staging use the custom domain attached to the private AVATARS R2 binding.
# 生产/预发布环境使用绑定到私有 AVATARS R2 的自定义域名。
AVATAR_PUBLIC_ORIGIN=https://avatars-development.moesegfault.dev
OAUTH_ENABLED=false
OIDC_ACTIVE_KID=disabled
PUBLIC_JWKS={"keys":[]}
WEBAUTHN_RP_ID=localhost
REGISTRATION_PEPPER=development-registration-pepper
RECOVERY_CODE_PEPPER=development-recovery-code-pepper
TRANSACTION_PEPPER=development-transaction-pepper
TRANSACTION_STATE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SESSION_PEPPER=development-session-pepper
CSRF_PEPPER=development-csrf-pepper
# OAuth-only values are required when OAUTH_ENABLED=true. / 仅在 OAUTH_ENABLED=true 时需要下列值。
AUTHORIZATION_CODE_PEPPER=development-authorization-code-pepper
REFRESH_TOKEN_PEPPER=development-refresh-token-pepper
PAIRWISE_SUBJECT_KEY=development-pairwise-subject-key
