# Local-only Worker variables; copy to .dev.vars. / 仅限本地的 Worker 变量，请复制为 .dev.vars。
ENVIRONMENT=development
ISSUER=http://localhost:8787
LOGIN_ORIGIN=http://localhost:5173
ACCOUNT_ORIGIN=http://localhost:5174
# Production/staging publish immutable reads through an R2 custom domain; the AVATARS
# Worker binding retains private write/delete authority. / 生产/预发布通过 R2 自定义域名
# 公开不可变读取；AVATARS Worker binding 仍独占私有写入/删除权限。
AVATAR_PUBLIC_ORIGIN=https://avatars-development.moesegfault.dev
OAUTH_ENABLED=false
OIDC_ACTIVE_KID=disabled
PUBLIC_JWKS={"keys":[]}
WEBAUTHN_RP_ID=localhost
# Cloudflare's EMAIL binding is configured in wrangler.identity.jsonc; these values
# define message identity and verification policy. / Cloudflare EMAIL binding 配置在
# wrangler.identity.jsonc；以下值定义邮件身份与验证策略。
EMAIL_FROM_ADDRESS=identity@moesegfault.dev
EMAIL_FROM_NAME=moeSegFault Identity
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_HOURLY_LIMIT=5
CONTACT_VERIFICATION_PEPPER=development-contact-verification-pepper
# Base64url-encoded 32-byte XChaCha20-Poly1305 key; use a random secret outside development.
# Base64url 编码的 32 字节 XChaCha20-Poly1305 密钥；非开发环境必须使用随机秘密。
EMAIL_OUTBOX_KEY_V1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
REGISTRATION_PEPPER=development-registration-pepper
RECOVERY_CODE_PEPPER=development-recovery-code-pepper
TRANSACTION_PEPPER=development-transaction-pepper
TRANSACTION_STATE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SESSION_PEPPER=development-session-pepper
CSRF_PEPPER=development-csrf-pepper
# OAuth-only values are required when OAUTH_ENABLED=true. / 仅在 OAUTH_ENABLED=true 时需要下列值。
AUTHORIZATION_CODE_PEPPER=development-authorization-code-pepper
REFRESH_TOKEN_PEPPER=development-refresh-token-pepper
PAIRWISE_SUBJECT_KEY=development-pairwise-subject-key
